# AI API Keys
# Rename this file to .env or use the Settings page to configure these.

# Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Configuration

DEFAULT_AI_MODEL=gemini/gemini-3-pro

# Optional: maximum number of tool-calling turns per chat response. Default 24.
# A full board-design pass (plan, search parts, extract pinouts, build the
# netlist, ERC, compile) needs many turns; don't set this too low.
AI_MAX_TOOL_TURNS=24

# Server Configuration
# Port to run the backend API server. Default is 8080.
PORT=8080
